<Window x:Class="FileSearcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文档内容搜索工具"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第1行：关键词输入 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="关键词：" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
            <TextBox x:Name="TxtKeyword" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                     FontSize="13" Padding="6,0" KeyDown="TxtKeyword_KeyDown"/>
        </Grid>

        <!-- 第2行：选择文件夹 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSelectFolder" Grid.Column="0" Content="选择文件夹" Width="90" Height="30"
                    Click="BtnSelectFolder_Click" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtFolderPath" Grid.Column="1" Text="未选择文件夹"
                       VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Grid>

        <!-- 第3行：搜索按钮 + 停止按钮 + 进度条 -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSearch" Grid.Column="0" Content="开始搜索" Width="90" Height="30"
                    Click="BtnSearch_Click" FontWeight="Bold"/>
            <Button x:Name="BtnStop" Grid.Column="1" Content="停止搜索" Width="90" Height="30"
                    Click="BtnStop_Click" Margin="8,0,0,0" Visibility="Collapsed"
                    Foreground="Red" FontWeight="Bold"/>
            <ProgressBar x:Name="ProgressBar" Grid.Column="2" Height="20" Margin="12,0"
                         Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="3" Text="" VerticalAlignment="Center"
                       FontSize="12" Foreground="#666"/>
        </Grid>

        <!-- 第4行：结果展示区 -->
        <TextBox x:Name="TxtResults" Grid.Row="3" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" FontFamily="Consolas, Microsoft YaHei"
                 FontSize="12" Padding="8" AcceptsReturn="True"
                 BorderBrush="#CCC" BorderThickness="1"/>

        <!-- 第5行：导出按钮 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Button x:Name="BtnExport" Content="导出 CSV" Width="90" Height="30"
                    HorizontalAlignment="Left" Click="BtnExport_Click"
                    IsEnabled="False"/>
        </Grid>

        <!-- 第6行：状态栏 -->
        <TextBlock x:Name="TxtInfo" Grid.Row="5" Margin="0,6,0,0"
                   FontSize="11" Foreground="#999"/>
    </Grid>
</Window>
